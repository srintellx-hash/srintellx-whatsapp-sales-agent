# ===== App =====
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# ===== Database =====
# Railway injects DATABASE_URL automatically when you add a PostgreSQL plugin.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/srintellx

# ===== LLM (Groq — free, OpenAI-compatible) =====
# Get your free key at https://console.groq.com/keys
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.3

# ===== Meta WhatsApp Business Cloud API =====
WHATSAPP_TOKEN=EAAG...                 # permanent system-user access token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=choose-any-random-string
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_API_VERSION=v21.0

# ===== Google Calendar =====
GOOGLE_CALENDAR_ID=primary
# Paste the FULL service-account JSON as a single-line string here, OR set a file path.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
DEMO_ORGANIZER_EMAIL=rajesh@srintellx.com

# ===== Sales rules =====
ESCALATION_CONTACT_NAME=Rajesh
COMPANY_CITY=Bangalore
DEMO_DURATION_MINUTES=30

# ===== Security =====
RATE_LIMIT_PER_MINUTE=20
ALLOWED_ORIGINS=*
